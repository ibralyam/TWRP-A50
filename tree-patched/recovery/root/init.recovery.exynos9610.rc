on early-init
    setprop ro.ibralyam.twrp.hybrid 1
    write /sys/fs/selinux/enforce 0

on init
    write /proc/sys/kernel/hung_task_timeout_secs 0
    symlink /system/bin/twrp_applet /system/bin/xzcat
    symlink /system/bin/twrp_applet /system/bin/unxz
    symlink /system/bin/twrp_applet /system/bin/busybox

on late-init
    setprop service.adb.root 1
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb

on fs
    wait /dev/block/platform/13520000.ufs
    symlink /dev/block/platform/13520000.ufs /dev/block/bootdevice
    symlink /dev/block/platform/13520000.ufs/by-name /dev/block/by-name
    mkdir /sbin 0755 root root
    symlink /system/bin/sh /sbin/sh
    start hwservicemanager

service hwservicemanager /system/bin/hwservicemanager
    user root
    group root
    disabled
    onrestart setprop hwservicemanager.ready false
    seclabel u:r:recovery:s0

on boot
    mount tmpfs tmpfs /tmp remount rw
    start health-hal-2-1
